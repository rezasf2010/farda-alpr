async function sendAndReceiveData() {
      const dataToSend = {
        f_name: "Farzad",
        l_name: "Ganjizadeh",
        user_name: "admin",
        password: "admin@123", // ======> hash type
        permission: { "1": true, "2": false, "3": false, "4": true } // ======> jsonb type
      };

      try {
        const response = await fetch('/api/data', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(dataToSend)
        });

        if (!response.ok) {
          throw new Error(Server error: ${response.status});
        }

        const receivedData = await response.json();
        console.log("✅ server response:", receivedData);
      } 
      catch (error) {
        console.error("❌ error:", error);
      }
    }

    document.getElementById('send-btn').addEventListener('click', sendAndReceiveData)
